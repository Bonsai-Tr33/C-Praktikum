    "def lin(x, m, a):\n",
    "    return m*x+a\n",
    "\n",
    "def intersect(m1, m2, a1, a2):\n",
    "    return (a2 - a1) / (m1 - m2)\n",
    "\n",
    "def DX(M1, M2, a1, a2, DM1, DM2, Da1, Da2):\n",
    "    u = M1 - M2\n",
    "    v = a2 - a1\n",
    "    return np.sqrt((Da1**2+Da2**2)/(u**2) + (v**2)/(v**2) * (DM1**2 + DM2**2)/(u**2))\n",
    "\n",
    "\n",
    "e = 1.602176634 * 10**(-19)  # elementary charge in C\n",
    "c = 299792458  # speed of light in m/s"
   ]
